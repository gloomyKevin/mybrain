7, "seek": 11720, "start": 127.52000000000001, "end": 129.4, "text": "這個說的是很清漂亮的一句話", "tokens": [50880, 6287, 4622, 24620, 4563, 21784, 29019, 1546, 2257, 34592, 11103, 50974], "temperature": 0, "avg_logprob": -0.22366111997574095, "compression_ratio": 1.3540856031128405, "no_speech_prob": 0.0169108547270298}, {"id": 48, "seek": 11720, "start": 129.4, "end": 132.04, "text": "但是就是殘酷只是難以想像的", "tokens": [50974, 11189, 5620, 15976, 246, 16911, 115, 36859, 21192, 3588, 7093, 12760, 1546, 51106], "temperature": 0, "avg_logprob": -0.22366111997574095, "compression_ratio": 1.3540856031128405, "no_speech_prob": 0.0169108547270298}, {"id": 49, "seek": 11720, "start": 132.04, "end": 134.48000000000002, "text": "在一到兩年後就會出現", "tokens": [51106, 3581, 2257, 4511, 16313, 5157, 5661, 47778, 7781, 9581, 51228], "temperature": 0, "avg_logprob": -0.22366111997574095, "compression_ratio": 1.3540856031128405, "no_speech_prob": 0.0169108547270298}, {"id": 50, "seek": 11720, "start": 134.48000000000002, "end": 137.24, "text": "所以我覺得各位就是", "tokens": [51228, 7239, 17689, 22073, 5620, 51366], "temperature": 0, "avg_logprob": -0.22366111997574095, "compression_ratio": 1.3540856031128405, "no_speech_prob": 0.0169108547270298}, {"id": 51, "seek": 11720, "start": 137.24, "end": 139.64000000000001, "text": "也是可以作為參考", "tokens": [51366, 22021, 6723, 11914, 6344, 47375, 26504, 51486], "temperature": 0, "avg_logprob": -0.22366111997574095, "compression_ratio": 1.3540856031128405, "no_speech_prob": 0.0169108547270298}, {"id": 52, "seek": 11720, "start": 139.64000000000001, "end": 142.4, "text": "好那麼", "tokens": [51486, 2131, 20504, 51624], "temperature": 0, "avg_logprob": -0.22366111997574095, "compression_ratio": 1.3540856031128405, "no_speech_prob": 0.0169108547270298}, {"id": 53, "seek": 11720, "start": 142.4, "end": 144.36, "text": "第二個點", "tokens": [51624, 49085, 8216, 51722], "temperature": 0, "avg_logprob": -0.22366111997574095, "compression_ratio": 1.3540856031128405, "no_speech_prob": 0.01691